{
    "name": "@rapidmx/crm-plugin",
    "version": "0.1.0",
    "description": "RapidMX plugin that provides a customer relationship management and marketing platform: contacts, companies, mailing lists, campaigns, automations and sales pipelines.",
    "repository": "https://github.com/rapidmx/crm-plugin.git",
    "author": "RapidREST <rapidrests@gmail.com>",
    "license": "MPL-2.0",
    "contributors": [
        "Jean-Philippe Steinmetz"
    ],
    "scripts": {
        "build": "yarn lint && rimraf dist && tsc && tsc -p tsconfig.apps.json",
        "lint": "eslint ./src ./apps ./test",
        "local-audit": "yarn install && yarn npm audit -A -R \"$@\"",
        "checkup": "yarn dlx @yarnpkg/doctor \"$@\"",
        "dependency-check": "yarn dlx depcheck \"$@\"",
        "report-coverage": "cat ./coverage/lcov.info | coveralls",
        "test": "vitest run",
        "test:prod": "npm run lint && vitest run --coverage",
        "test:watch": "vitest",
        "release": "npx @rapidrest/cli release",
        "prepublish": "yarn build"
    },
    "peerDependencies": {
        "@dnd-kit/core": "6.x",
        "@rapidmx/restapi": ">=0.26.0 <1",
        "@rapidmx/web-client": ">=0.26.0 <1",
        "@rapidrest/core": "6.x",
        "@rapidrest/react": ">=2.1.0 <3",
        "@rapidrest/service-core": "2.x",
        "@tiptap/pm": "3.x",
        "@tiptap/react": "3.x",
        "@tiptap/starter-kit": "3.x",
        "react": "19.x",
        "react-dom": "19.x",
        "react-icons": "5.x"
    },
    "dependencies": {
        "@dnd-kit/sortable": "^10.0.0",
        "html-to-text": "^10.0.1",
        "liquidjs": "^10.29.0",
        "mjml": "^5.4.1",
        "nodemailer": "^10.0.1",
        "sanitize-html": "^2.17.7"
    },
    "devDependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@rapidmx/restapi": "^0.26.0",
        "@rapidmx/web-client": "^0.26.0",
        "@rapidrest/core": "^6.0.0",
        "@rapidrest/react": "^2.1.0",
        "@rapidrest/service-core": "^2.4.0",
        "@swc/core": "1.16.2",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@tiptap/pm": "^3.31.3",
        "@tiptap/react": "^3.31.3",
        "@tiptap/starter-kit": "^3.31.3",
        "@types/html-to-text": "^9.0.4",
        "@types/nconf": "^0.10.7",
        "@types/node": "^26.5.0",
        "@types/nodemailer": "^8.0.1",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "@types/sanitize-html": "^2.16.2",
        "@typescript-eslint/eslint-plugin": "^8.70.0",
        "@typescript-eslint/parser": "^8.70.0",
        "@vitest/coverage-v8": "^5.0.0",
        "better-sqlite3": "^13.0.3",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsdoc": "^64.3.6",
        "globals": "^17.12.0",
        "jsdom": "^30.0.1",
        "lodash-es": "^4.18.1",
        "mailparser": "^3.9.0",
        "mongodb": "^7.6.0",
        "mongodb-memory-server": "^11.2.0",
        "nconf": "^0.13.0",
        "openapi3-ts": "^4.6.1",
        "prom-client": "^15.1.3",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-icons": "^5.7.0",
        "redis": "^6.2.1",
        "reflect-metadata": "^0.2.2",
        "rimraf": "^6.1.3",
        "ts-node": "^10.9.2",
        "tsx": "^4.23.13",
        "typeorm": "^1.1.1",
        "typescript": "^6.0.3",
        "unplugin-swc": "^1.6.0",
        "uuid": "^14.0.2",
        "vite": "^8.2.2",
        "vitest": "^5.0.0",
        "winston": "^3.19.0"
    },
    "resolutions": {
        "@rapidmx/restapi": "^0.26.0",
        "@rapidmx/web-client": "^0.26.0"
    },
    "packageManager": "yarn@4.5.3",
    "engines": {
        "node": ">=24.0.0"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org/"
    },
    "type": "module",
    "main": "dist/lib/index.js",
    "exports": {
        ".": {
            "import": "./dist/lib/index.js",
            "types": "./dist/types/index.d.ts"
        },
        "./mongo": {
            "import": "./dist/lib/mongo.js",
            "types": "./dist/types/mongo.d.ts"
        },
        "./sql": {
            "import": "./dist/lib/sql.js",
            "types": "./dist/types/sql.d.ts"
        },
        "./purge": {
            "import": "./dist/lib/purge.js",
            "types": "./dist/types/purge.d.ts"
        }
    },
    "typings": "dist/types/index.d.ts",
    "files": [
        "apps",
        "dist"
    ],
    "rapidmx": {
        "plugin": {
            "apiVersion": 1,
            "displayName": "CRM",
            "description": "Adds a customer relationship management app at /crm: shared workspaces of contacts, companies and deals with custom properties, notes, tasks and an activity timeline; mailing lists with signup forms, double opt-in and a subscriber preference center; an email designer, campaigns with tracking and A/B tests, segments, lead scoring and automations; sales pipelines; reports; webhooks and an integration API - and a CRM page in the admin console.",
            "mailboxScopedData": true,
            "settings": [
                {
                    "key": "mail:crm:public_url",
                    "label": "Public site address",
                    "type": "string",
                    "default": "https://<host>",
                    "help": "The address the CRM's public pages (signup forms, the preference center, unsubscribe links) are served from, for example https://mail.example.com. Links in CRM emails point here."
                },
                {
                    "key": "mail:crm:workspace_creator_roles",
                    "label": "Who can create workspaces",
                    "type": "string",
                    "default": "",
                    "help": "A comma-separated list of roles allowed to create CRM workspaces. Leave empty to let every signed-in user create one."
                },
                {
                    "key": "mail:crm:max_workspaces_per_user",
                    "label": "Workspaces per user",
                    "type": "number",
                    "default": 10,
                    "help": "How many workspaces one user may create."
                },
                {
                    "key": "mail:crm:send_rate_per_minute",
                    "label": "Campaign messages per minute",
                    "type": "number",
                    "default": 600,
                    "help": "The most campaign messages the whole deployment sends per minute, shared by every workspace. Raise it only as far as your mail server and its reputation allow."
                },
                {
                    "key": "mail:crm:verp",
                    "label": "Per-message bounce addresses",
                    "type": "boolean",
                    "default": true,
                    "help": "Send each campaign message with its own bounce address (the sender's address plus a +b- tag), so bounces are matched to their message reliably. Needs plus-addressing, which RapidMX has on by default."
                }
            ],
            "ui": {
                "apps": [
                    {
                        "id": "crm",
                        "host": "www",
                        "mount": "/crm",
                        "dir": "apps/crm"
                    },
                    {
                        "id": "subscriptions",
                        "host": "public",
                        "mount": "/subscriptions",
                        "dir": "apps/subscriptions"
                    },
                    {
                        "id": "forms",
                        "host": "public",
                        "mount": "/f",
                        "dir": "apps/f"
                    },
                    {
                        "id": "crm-admin",
                        "host": "admin",
                        "mount": "/admin/crm",
                        "dir": "apps/admin-crm"
                    }
                ],
                "appRail": [
                    {
                        "id": "crm",
                        "label": "CRM",
                        "href": "/crm",
                        "icon": "HiOutlineUserGroup"
                    }
                ],
                "adminNav": [
                    {
                        "id": "crm",
                        "label": "CRM",
                        "href": "/admin/crm",
                        "icon": "HiOutlineUserGroup"
                    }
                ]
            }
        }
    }
}
